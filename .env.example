# Environment Variables — TikTok Downloader

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# 32-character secret key for encrypting cookies at rest
COOKIE_ENCRYPTION_KEY=change-this-to-a-32-char-secret!!

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=3600000

# ─────────────────────────────────────────────
# BINARY PATHS (leave empty to use system PATH)
# ─────────────────────────────────────────────
YTDLP_PATH=
FFMPEG_PATH=

# ─────────────────────────────────────────────
# PROXY (optional, for geo-bypass)
# ─────────────────────────────────────────────
PROXY_URL=

# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=TikTok Downloader
NEXT_PUBLIC_APP_URL=http://localhost:3000
