# Environment Variables — TikTok Downloader

# ─────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────
# 32-character secret key for encrypting cookies at rest (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_ENCRYPTION_KEY=change-this-to-a-32-char-secret!!

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
# Max requests per IP per window (default: 20 requests per hour)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=3600000

# ─────────────────────────────────────────────
# BINARY PATHS (leave empty to use system PATH)
# ─────────────────────────────────────────────
YTDLP_PATH=
FFMPEG_PATH=

# ─────────────────────────────────────────────
# COOKIES (untuk deployment cloud seperti Render)
# ─────────────────────────────────────────────
# Paste JSON array cookies TikTok Anda di sini (satu baris)
TIKTOK_COOKIES_JSON=

# ─────────────────────────────────────────────
# PROXY (optional, for geo-bypass)
# ─────────────────────────────────────────────
PROXY_URL=

# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=TikTok Downloader
NEXT_PUBLIC_APP_URL=http://localhost:3000
